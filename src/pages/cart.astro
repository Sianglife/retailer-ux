---
import Layout from "../layout.astro";
---

<style is:global>
    /* Hide the arrow of input */
    input[type=number]::-webkit-outer-spin-button,
    input[type=number]::-webkit-inner-spin-button {
        -webkit-appearance: none;
        margin: 0;
    }
    input[type=number] {
        -moz-appearance: textfield;
    }

    .cart-card-container {
        display: flex;
        flex-direction: row;
        justify-content: space-between;
        align-items: center;
    }

    .cart-card-title {
    }

    .cart-card-img {
        width: 7rem;
        justify-items: center;
        padding: 0.5rem; 
    }

    img {
        width: 100%;  
    }

    .cart-card-actions {
        display: flex;
        flex-direction: row;
        width: fit-content;
        align-self: end;
        margin-bottom: 1rem;
        gap: 0.3rem;
        padding: 0.5rem;
    }

    .cart-card-count {
        width: 2rem;
        height: 2rem;
        text-align: center;
    }

    .cart-card-minus, .cart-card-plus {
        background-color: white;
        border: 1px solid #d1d5db;
        color: #374151;
        height: 2rem;
        width: 2rem;
        font-size: 1rem;
        /* padding: 0.2rem; */
        border-radius: 0.375rem;
        cursor: pointer;
    }
    
    .cart-card-minus:hover, .cart-card-plus:hover {
        background-color: rgb(215, 215, 215);

    }

</style>

<Layout>
    <article class="cart-card-container">
        <div class="cart-card-img">
            <img src="https://img.technews.tw/wp-content/uploads/2015/09/Google-logo_1.jpg" data-image-component="true" alt="A bottle of whole milk" data-astro-cid-3m2yufef="true" loading="lazy" decoding="async" width="300" height="300">
        </div>
        <div class="cart-card-title">
            <h3>TITLE</h3>
        </div>
        <div class="cart-card-actions">
            <button id="cart-card-minus-id" class="cart-card-minus">-</button>
            <input type="number" id="cart-card-count-id" class="cart-card-count" min="0">
            <button id="cart-card-plus-id" class="cart-card-plus">+</button>
        </div>
    </article>

    <article>
        <p>total$<strong>TOTAL</strong></p>
    </article>

    <button>submit</button>
</Layout>