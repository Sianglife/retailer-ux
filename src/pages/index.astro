---
import Layout from "../layout.astro";
import ListCard from "../components/listCard.astro";
import DialogModal from "../components/dialogModal.astro";
import DetailPage from "../components/detailPage.astro";
import Cart from "../components/cart.astro";
import { products } from "../data/products.ts";
---

<style>
	.header {
		height: 4rem;
		display: flex;
		justify-content: space-between;
	}

	h1 {
		font-size: 1.5rem;
		font-weight: 500;
		align-self: center;
		padding-left: 1rem;
	}
</style>

<Layout>
	<div class="header">
		<h1>Retailer UX</h1>
		<Cart />
	</div>
	{products.map(item => (
		<DialogModal modal_id={`modal-${item.id}`} title={item.title}>
			<ListCard slot="trigger" image_source={item.image_source} image_alt={item.image_alt} title={item.title} description={item.description} price={item.price} />
			<DetailPage slot="body" id={item.id} image_source={item.image_source} image_alt={item.image_alt} description={item.description} price={item.price} />
		</DialogModal>
	))}
</Layout>
