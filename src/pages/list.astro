---
import Layout from '../layout.astro';
import ListCard from "../components/listCard.astro";
import DialogModal from "../components/dialogModal.astro";
import DetailPage from '../components/detailPage.astro';

const products = [
  {
    "id": "product-001",
    "title": "Fresh Milk",
    "description": "Whole milk, 936 mL",
    "price": 95,
    "image_source": "https://img.technews.tw/wp-content/uploads/2015/09/Google-logo_1.jpg",
    "image_alt": "A bottle of whole milk"
  },
  {
    "id": "product-002",
    "title": "Whole Wheat Bread",
    "description": "Freshly baked, 6 slices",
    "price": 55,
    "image_source": "/images/bread.jpg",
    "image_alt": "Sliced whole wheat bread"
  },
  {
    "id": "product-003",
    "title": "Free-Range Eggs",
    "description": "One carton of 10 eggs",
    "price": 89,
    "image_source": "/images/eggs.jpg",
    "image_alt": "A carton of eggs"
  },
  {
    "id": "product-004",
    "title": "Bananas",
    "description": "Locally grown, approximately 600 g",
    "price": 49,
    "image_source": "/images/bananas.jpg",
    "image_alt": "A bunch of yellow bananas"
  },
  {
    "id": "product-005",
    "title": "Ground Coffee",
    "description": "Medium roast, 250 g",
    "price": 249,
    "image_source": "/images/coffee.jpg",
    "image_alt": "A bag of ground coffee"
  },
  {
    "id": "product-006",
    "title": "Instant Noodles",
    "description": "Vegetable flavor, pack of 5",
    "price": 119,
    "image_source": "/images/noodles.jpg",
    "image_alt": "A pack of instant noodles"
  }
]


---

<style>
    .detail-trigger:hover {
        cursor: pointer
    }
</style>

<Layout>
{
    products.map((item) => {

        return (
            <DialogModal modal_id={`modal-${item.id}`} data-id={item.id} title={item.title}>
                <DetailPage 
                  slot="body" 
                  image_source={item.image_source}
                  image_alt={item.image_alt}
                  title={item.title}
                  description={item.description}
                  price={item.price}
                  other_notice="OTHERNOTICE"
                />

                <div id={item.id} class="detail-trigger" slot="trigger">
                    <ListCard 
                    image_source={item.image_source}
                    image_alt={item.image_alt}
                    title={item.title}
                    description={item.description}
                    price={item.price}
                    />
                </div>
            </DialogModal>
        )
    })
}
</Layout>

<script define:vars={{products}}>
for (let item of products) {
    console.log(item.id);
    const trigger = document.querySelector(`#${item.id}`);
    const dialog = document.querySelector(`#modal-${item.id}`);
    if (dialog instanceof HTMLDialogElement) {
        trigger?.addEventListener("click", () => {
        dialog.showModal();
        });
    }
}
</script>