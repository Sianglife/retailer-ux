---
const {id, image_source, image_alt, description, price, other_notice} = Astro.props;
import { Image } from "astro:assets";
---

<style>
    .image {
        justify-self: center;
    }
    
    .price-number {
        color: red;
        font-size: 2rem;
    }

    #price {
        margin: 0;
        font-size: 1.5rem;
        justify-self: center;
    }

    #desc_text, #other_text {
        padding: 1rem;
    }

    section {
        display: flex;
        flex-direction: column;
        align-items: center;
    }

    #price {
        width: fit-content;
    }

    button {
        margin: 1rem;
    }
</style>
<section>
    <Image id="image" src={image_source} alt={image_alt} class="image" width="300" height="300" />
    <article id="desc_text">
        <p>{description}</p>
    </article>

    <p id="other_text">{other_notice}</p>

    <p id="price">$&nbsp;<span class="price-number">{price}</span></p>

    <button data-id={id} data-price={price} class="buy-btn bg-blue-500 hover:bg-blue-700 text-white font-bold py-2 px-4 rounded-full">BUY</button>
</section>

<script>
    import { addToCart } from '../lib/cart';

    document.querySelectorAll<HTMLButtonElement>('.buy-btn').forEach((button) => {
        button.addEventListener('click', () => {
            try {
                addToCart(button.dataset.id ?? '');
                button.closest('dialog')?.close();
            } catch (error) {
                alert(error instanceof Error ? error.message : 'Your cart could not be saved.');
            }
        });
    });
</script>
