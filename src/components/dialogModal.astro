---
const {id, title, button_text, button_class = "bg-blue-500 hover:bg-blue-700 text-white font-bold py-2 px-4 rounded-full"} = Astro.props;
---
<style>
    dialog {
        justify-self: center;
        align-self: center;
    }

    #dialog-header {
        display: flex;
    }

    #dialog-title {
        text-align: center;
        width: 100%;
        justify-self: center;
        align-self: center;
    }

    #dialog-close {
        margin: 0.5rem;
    }

    #dialog-close:hover,
    button:hover {
        cursor: pointer
    }
</style>

<button  command="show-modal" commandfor={id}>
    <slot name="trigger">
        <p class={button_class}>{button_text}</p>
    </slot>
</button>

<dialog id={id} class="w-[90vw] max-w-md backdrop:backdrop-blur-sm">
    <div id="dialog-header">
        <h4 id="dialog-title">{title}</h4>
        <button id="dialog-close" commandfor={id} command="close">X</button>
    </div>
    
    <slot name="body" />

    <div id="dialog-footer">
        <slot name="footer"></slot>
    </div>
</dialog>