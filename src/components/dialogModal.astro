---
const {modal_id, title, button_text, button_class = "bg-blue-500 hover:bg-blue-700 text-white font-bold py-2 px-4 rounded-full"} = Astro.props;
---
<style>
    dialog {
        justify-self: center;
        align-self: center;
    }

    #dialog-header {
        display: flex;
    }

    #dialog-title {
        text-align: center;
        width: 100%;
        justify-self: center;
        align-self: center;
    }

    #dialog-close {
        margin: 0.5rem;
    }

    #dialog-close:hover,
    button:hover {
        cursor: pointer
    }
</style>

<slot name="trigger">
    <button command="show-modal" commandfor={modal_id}>
        <p class={button_class}>{button_text}</p>
    </button>
</slot>

<dialog id={modal_id} class="w-[90vw] max-w-md backdrop:backdrop-blur-sm">
    <div id="dialog-header">
        <h4 id="dialog-title">{title}</h4>
        <button id="dialog-close" commandfor={modal_id} command="close">X</button>
    </div>
    
    <slot name="body" />

    <div id="dialog-footer">
        <slot name="footer"></slot>
    </div>
</dialog>

<script>
const dialogs = document.querySelectorAll('dialog');
dialogs.forEach((dialog)=>{
    // Edit from Sample given by AI
    dialog.addEventListener("click", (event) => {
        if (event.target !== dialog) return;

        const rect = dialog.getBoundingClientRect();
        const outside =
            event.clientX < rect.left ||
            event.clientX > rect.right ||
            event.clientY < rect.top ||
            event.clientY > rect.bottom;

        if (outside) dialog.close();
    });
})
</script>