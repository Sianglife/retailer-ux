---
interface Props {
	autoOpen?: boolean;
}

const { autoOpen = false } = Astro.props;
---

<div class="cart" data-auto-open={autoOpen}>
	<button type="button" class="cart-trigger">
		Cart (<span class="cart-count">0</span>)
	</button>

	<dialog id="cart-modal">
		<header>
			<h2 id="cart-title">Your cart</h2>
			<button type="button" class="cart-close">
				✕
			</button>
		</header>

		<div class="cart-body">
			<p class="cart-empty">Your cart is empty. Add a product to get started.</p>
			<div class="cart-items"></div>
			<p class="cart-status" role="status"></p>
		</div>

		<footer>
			<p class="cart-total-price">
				Total $<strong class="cart-total">0</strong>
			</p>
			<button type="button" class="cart-done cart-close">
				Continue shopping
			</button>
		</footer>
	</dialog>

	<template class="cart-row-template">
		<article class="cart-card-container">
			<div class="cart-card-img">
				<img alt="" width="80" height="80" loading="lazy" />
			</div>
			<div class="cart-card-details">
				<h3 class="cart-item-title"></h3>
				<p>
					$<span class="cart-item-price"></span>&nbsp;each
				</p>
				<button type="button" class="cart-action cart-remove" data-action="remove">
					Remove
				</button>
			</div>
			<div class="cart-card-actions">
				<div class="cart-quantity">
					<button type="button" class="cart-action cart-minus" data-action="minus">
						−
					</button>
					<input type="number" class="cart-card-count" min="0" step="1" required />
					<button type="button" class="cart-action cart-plus" data-action="plus">
						+
					</button>
				</div>
				<p class="cart-subtotal">
					$<strong class="cart-item-subtotal"></strong>
				</p>
			</div>
		</article>
	</template>
	<noscript>Enable JavaScript to load your saved cart.</noscript>
</div>

<script>
	import { products } from "../data/products.ts";
	import { getCart, getQuantity, setCartCount } from "../lib/cart";

	const formatPrice = (price: number) => price.toLocaleString("zh-TW", { maximumFractionDigits: 2 });

	document.querySelectorAll<HTMLElement>(".cart").forEach(root => {
		const dialog = root.querySelector<HTMLDialogElement>("dialog")!;
		const container = root.querySelector<HTMLElement>(".cart-items")!;
		const template = root.querySelector<HTMLTemplateElement>(".cart-row-template")!;
		const status = root.querySelector<HTMLElement>(".cart-status")!;
		const trigger = root.querySelector<HTMLButtonElement>(".cart-trigger")!;

		function renderCart() {
			try {
				const cart = getCart();
				const quantity = getQuantity();
				// Restore keyboard focus when rebuilding rows after updating cart.
				const active = document.activeElement;
				const focusedRow = active instanceof HTMLElement ? active.closest<HTMLElement>(".cart-card-container") : null;
				const focusedId = focusedRow?.dataset.itemId;
				const focusedAction = active instanceof HTMLElement ? active.dataset.action : undefined;
				const focusedInput = active instanceof HTMLInputElement;
				container.replaceChildren();

				for (const item of cart.items) {
					const product = products.find(product => product.id === item.id)!;
					const row = template.content.firstElementChild!.cloneNode(true) as HTMLElement;
					row.dataset.itemId = item.id;
					const image = row.querySelector("img")!;
					image.src = product.image_source;
					image.alt = product.image_alt;
					image.addEventListener("error", () => {
						image.hidden = true;
					});
					row.querySelector(".cart-item-title")!.textContent = product.title;
					row.querySelector(".cart-item-price")!.textContent = formatPrice(item.one_price);
					row.querySelector(".cart-item-subtotal")!.textContent = formatPrice(item.one_price * item.count);

					const input = row.querySelector("input")!;
					const available = quantity.find(stock => stock.id === item.id)?.count ?? 0;
					input.value = String(item.count);
					input.max = String(item.count + available);
					const plus = row.querySelector<HTMLButtonElement>(".cart-plus")!;
					plus.disabled = available === 0;
					container.append(row);
				}

				root.querySelector<HTMLElement>(".cart-empty")!.hidden = cart.items.length > 0;
				root.querySelector(".cart-count")!.textContent = String(cart.items.reduce((total, item) => total + item.count, 0));
				root.querySelector(".cart-total")!.textContent = formatPrice(cart.total);
				if (focusedId) {
					const row = Array.from(container.children).find(row => (row as HTMLElement).dataset.itemId === focusedId);
					const selector = focusedInput ? "input" : `.cart-${focusedAction}`;
					const target = row?.querySelector<HTMLElement>(selector);
					if (target && !(target instanceof HTMLButtonElement && target.disabled)) target.focus();
					else (row?.querySelector("input") ?? dialog.querySelector<HTMLButtonElement>(".cart-close"))?.focus();
				}
			} catch {
				status.textContent = "Cart could not be loaded.";
			}
		}

		function updateCount(id: string, count: number) {
			status.textContent = "";
			try {
				setCartCount(id, count);
			} catch (error) {
				status.textContent = error instanceof Error ? error.message : "Your cart could not be saved.";
				renderCart();
			}
		}

		container.addEventListener("click", event => {
			const button = event.target instanceof Element ? event.target.closest<HTMLButtonElement>(".cart-action") : null;
			const row = button?.closest<HTMLElement>(".cart-card-container");
			if (!button || !row?.dataset.itemId) return;
			const item = getCart().items.find(item => item.id === row.dataset.itemId);
			if (!item) return;
			updateCount(item.id, button.dataset.action === "remove" ? 0 : item.count + (button.dataset.action === "plus" ? 1 : -1));
		});

		container.addEventListener("change", event => {
			if (!(event.target instanceof HTMLInputElement)) return;
			const id = event.target.closest<HTMLElement>(".cart-card-container")?.dataset.itemId;
			if (id) updateCount(id, event.target.valueAsNumber);
		});

		trigger.addEventListener("click", () => {
			status.textContent = "";
			renderCart();
			dialog.showModal();
		});
		root.querySelectorAll(".cart-close").forEach(button => {
			button.addEventListener("click", () => dialog.close());
		});

		// Auto close when click on out of dialog
		dialog.addEventListener("click", event => {
			if (event.target !== dialog) return;
			const rect = dialog.getBoundingClientRect();
			if (event.clientX < rect.left || event.clientX > rect.right || event.clientY < rect.top || event.clientY > rect.bottom) dialog.close();
		});
		window.addEventListener("cart-updated", renderCart);
		window.addEventListener("storage", event => {
			if (event.key === "cart" || event.key === "quantity" || event.key === null) renderCart();
		});
		renderCart();
		if (root.dataset.autoOpen === "true") dialog.showModal();
	});
</script>

<style>
	/* style adjust by AI */
	button {
		cursor: pointer;
		border: 1px solid #d1d5db;
		border-radius: 0.375rem;
		padding: 0.4rem 0.75rem;
		background: white;
		color: #374151;
	}
	
	button:not(.cart-remove):hover {
		background: #f3f4f6;
	}
	button:disabled {
		cursor: not-allowed;
		opacity: 0.45;
	}
	button:focus-visible,
	input:focus-visible {
		outline: 2px solid #2563eb;
		outline-offset: 2px;
	}
	.cart-trigger {
		margin: 1rem;
	}
	dialog {
		margin: auto;
		width: min(92vw, 36rem);
		max-height: 85dvh;
		overflow-y: auto;
		border: 1px solid #d1d5db;
		border-radius: 0.75rem;
		padding: 0;
		box-shadow: 0 20px 60px #0003;
	}
	dialog::backdrop {
		background: #0006;
		backdrop-filter: blur(3px);
	}
	header {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		padding: 1rem;
		border-bottom: 1px solid #e5e7eb;
	}
	h2 {
		font-size: 1.4rem;
		font-weight: 700;
	}
	.cart-body {
		padding: 0 1rem;
	}
	.cart-empty {
		padding: 2rem 0;
		text-align: center;
		color: #4b5563;
	}
	.cart-card-container {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		padding: 1rem 0;
		border-bottom: 1px solid #e5e7eb;
	}
	.cart-card-img {
		width: 4rem;
		flex-shrink: 0;
	}
	img {
		width: 100%;
		height: 4rem;
		object-fit: contain;
	}
	.cart-card-details {
		flex: 1;
		min-width: 0;
	}
	h3 {
		font-weight: 600;
		overflow-wrap: anywhere;
	}
	.cart-card-details p {
		color: #4b5563;
	}
	.cart-remove {
		border: 0;
		padding: 0.25rem 0;
		color: #b91c1c;
		background: transparent;
		text-decoration: underline;
	}
	.cart-card-actions {
		flex-shrink: 0;
	}
	.cart-quantity {
		display: flex;
		align-items: center;
		gap: 0.25rem;
	}
	.cart-quantity button {
		width: 2rem;
		height: 2rem;
		padding: 0;
	}
	.cart-card-count {
		width: 3rem;
		height: 2rem;
		text-align: center;
		border: 1px solid #d1d5db;
		border-radius: 0.375rem;
		appearance: textfield;
	}
	.cart-card-count::-webkit-inner-spin-button,
	.cart-card-count::-webkit-outer-spin-button {
		-webkit-appearance: none;
		margin: 0;
	}
	.cart-subtotal {
		margin-top: 0.5rem;
		text-align: right;
	}
	.cart-status {
		color: #b91c1c;
		margin: 0.75rem 0;
	}
	.cart-status:empty {
		display: none;
	}
	footer {
		padding: 1rem;
	}
	.cart-total-price {
		text-align: right;
		margin-bottom: 1rem;
	}
	.cart-total {
		color: #bc0202;
		font-size: 1.5rem;
		margin-left: 0.25rem;
	}
	.cart-done {
		display: block;
		margin-left: auto;
	}
	@media (max-width: 480px) {
		.cart-card-container {
			flex-wrap: wrap;
		}
		.cart-card-actions {
			flex-basis: 100%;
			display: flex;
			align-items: center;
			justify-content: space-between;
			padding-left: 4.75rem;
		}
		.cart-subtotal {
			margin-top: 0;
		}
	}
</style>
