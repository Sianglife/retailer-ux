---
import { Image } from 'astro:assets';
const { image_source, image_alt, title, description, price } = Astro.props;
const formattedPrice = price.toLocaleString('zh-TW', { maximumFractionDigits: 2 });
---

<button type="button" class="list-card">
    <span class="list-card-image">
        <Image src={image_source} alt={image_alt} width="300" height="300" />
    </span>
    <span class="list-card-content">
        <strong class="list-card-title">{title}</strong>
        <span class="list-card-description">{description}</span>
    </span>
    <span class="list-card-price">$<strong class="price-number">{formattedPrice}</strong></span>
</button>

<script>
    document.querySelectorAll<HTMLImageElement>('.list-card-image img').forEach((image) => {
        image.addEventListener('error', () => { image.hidden = true; });
        if (image.complete && image.naturalWidth === 0) image.hidden = true;
    });
</script>

<style>
    .list-card {
        display: grid;
        grid-template-columns: 4rem minmax(0, 1fr) auto;
        align-items: center;
        gap: 1rem;
        width: 100%;
        padding: 1rem 1.5rem;
        border-top: 1px solid #e5e7eb;
        background: white;
        color: #374151;
        text-align: left;
        cursor: pointer;
    }
    .list-card:hover { background: #f3f4f6; }
    .list-card:focus-visible { outline: 2px solid #2563eb; outline-offset: -2px; }
    .list-card-image img { width: 4rem; height: 4rem; object-fit: contain; }
    .list-card-content { display: flex; flex-direction: column; gap: 0.5rem; min-width: 0; }
    .list-card-title { font-size: 1.25rem; overflow-wrap: anywhere; }
    .list-card-description { overflow-wrap: anywhere; }
    .list-card-price { white-space: nowrap; }
    .price-number { margin-left: 0.25rem; font-size: 1.5rem; color: #bc0202; }
    @media (max-width: 480px) {
        .list-card { grid-template-columns: 4rem minmax(0, 1fr); padding: 1rem; gap: 0.75rem; }
        .list-card-price { grid-column: 2; justify-self: end; }
    }
</style>
