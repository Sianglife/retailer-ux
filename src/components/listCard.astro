---
import { Image } from "astro:assets";
const { image_source, image_alt, title, description, price, id} = Astro.props;
---
<style>
    img {
        max-height: 100%;
        width: auto;
    }

    #card-container {
        padding: 1rem 1.5rem;
        display: flex;
        flex-direction: row;
        justify-content: space-between;
        border-style: dotted;
        border-width: 3px 0;
        gap: 1rem;
        height: 8rem;
    }
    
    .section-container {
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }

    #content {        
        width: 100%;
    }

    #action {
        justify-content: end;
    }

    .price-number {
        color: red;
        font-size: 2rem;
    }

    h3, p {
        margin: 0;
        font-size: 1.5rem;
    }
</style>

<article id="card-container">
    <div id="image" class="section-container">        
        <Image src={image_source} alt={image_alt} width="300" height="300" />
    </div>
    <div id="content" class="section-container">
        <h3>{title}</h3>
        <p>{description}</p>
    </div>
    <div id="action" class="section-container">
        <p>$&nbsp;<span class="price-number">{price}</span></p>
        <button>buy</button>
    </div>
</article>

<script>
    // TODO: open modal
</script>