---
import { Image } from "astro:assets";
const { image_source, image_alt, title, description, price } = Astro.props;
const formattedPrice = price.toLocaleString("zh-TW", { maximumFractionDigits: 2 });
---

<button type="button" class="list-card">
	<span class="list-card-image">
		<Image src={image_source} alt={image_alt} width="300" height="300" />
	</span>
	<span class="list-card-content">
		<strong class="list-card-title">{title}</strong>
		<span class="list-card-description">{description}</span>
	</span>
	<span class="list-card-price">
		$<strong class="price-number">{formattedPrice}</strong>
	</span>
</button>

<script>
	document.querySelectorAll<HTMLImageElement>(".list-card-image img").forEach(image => {
		image.addEventListener("error", () => {
			image.hidden = true;
		});
		if (image.complete && image.naturalWidth === 0) image.hidden = true;
	});
</script>

<style>
	.list-card {
		display: flex;
		flex-direction: row;
		justify-content: space-between;
		gap: 1rem;
		width: 100%;
		padding: 1rem 1.5rem;
		border-style: dotted;
		border-width: 3px 0 0;
		border-color: #e5e7eb;
		background: white;
		color: #374151;
		text-align: left;
		cursor: pointer;
	}

	.list-card:hover {
		background: #f3f4f6;
	}
	.list-card:focus-visible {
		outline: 2px solid #2563eb;
		outline-offset: -2px;
	}
	.list-card-image {
		display: flex;
		flex-direction: column;
		flex-shrink: 0;
	}
	.list-card-image img {
		max-height: 7rem;
		width: auto;
		object-fit: contain;
		min-width: 11.5rem;
	}
	.list-card-content {
		display: flex;
		flex-direction: column;
		gap: 1rem;
		width: 100%;
		min-width: 0;
	}
	.list-card-title,
	.list-card-description {
		font-size: 1rem;
		overflow: hidden;
		text-overflow: ellipsis;
	}
	.list-card-price {
		display: flex;
		align-items: flex-end;
		font-size: 1.5rem;
		white-space: nowrap;
	}
	.price-number {
		margin-left: 0.25rem;
		font-size: 2rem;
		font-weight: normal;
		color: #bc0202;
	}

	@media (max-width: 768px) {
		.list-card {
			flex-direction: column;
			height: auto;
			gap: 0.7rem;
		}
		.list-card-content {
			gap: 0.5rem;
		}
		.list-card-image {
			min-width: auto;
		}
		.list-card-title, .list-card-description, .list-card-price {
			font-size: 1rem;
		}
		.list-card-price {
			justify-content: center;
		}
		.price-number {
			font-size: 1.2rem;
		}
	}
</style>
